import "https://raw.githubusercontent.com/CollaborativeStateMachines/Cirrina/refs/heads/develop/src/main/resources/pkl/csm/Csml.pkl"

class StateMachine extends Csml.StateMachineDescription {
  name = "philosopher"
  local self = this
  localContext {
    variables {
      new {
        name = "counter"
        value = "0"
      }
    }
  }
  states {
   new Csml.StateDescription {
     name = "requestingFork"
     initial = true
     after {
       new Csml.TimeoutActionDescription {
         name = "requestFork"
         delay = "100"
         action = new Csml.RaiseActionDescription {
           event {
             name = "requesting"
             data {
               new {
                 name = "fork"
                 value = self.name
               }
             }
             channel = "global"
           }
         }
       }
     }
     on {
         new Csml.OnTransitionDescription {
           event = "allocated"
           guards {
             new Csml.GuardDescription {
               expression = "$fork == \(self.name) && $fork2 == \(self.name) + 1"
             }
           }
           target = "eating"
         }
     }
   }
    new Csml.StateDescription {
      name = "eating"
      entry {
        new Csml.AssignActionDescription {
          variable = new {
            name = "counter"
            value = "counter + 1"
          }
        }
      }
      after {
        new Csml.TimeoutActionDescription {
          name = "finishedEating"
          delay = "100"
          action = new Csml.RaiseActionDescription {
            event {
              name = "finished"
              data {
                new {
                  name = "fork"
                  value = self.name
                }
              }
              channel = "global"
            }
          }
        }
      }
      on {
        new Csml.OnTransitionDescription {
          event = "finished"
          guards {
            new Csml.GuardDescription {
              expression = "$fork == \(self.name)"
            }
            new Csml.GuardDescription {
              expression = "counter < 100"
            }
          }
          target = "requestingFork"
        }
        new Csml.OnTransitionDescription {
          event = "finished"
          guards {
            new Csml.GuardDescription {
              expression = "$fork == \(self.name)"
            }
            new Csml.GuardDescription {
              expression = "counter >= 100"
            }
          }
          target = "leave"
        }
      }
    }
    new Csml.StateDescription {
      name = "leave"
      terminal = true
    }
  }
}