amends
  "https://raw.githubusercontent.com/CollaborativeStateMachines/Cirrina/refs/heads/develop/src/main/resources/pkl/csm/csml.pkl"

local n = 12

collaborativeStateMachine {
  stateMachines {
    ["philosopher"] {
      states {
        ["hungry"] = new Initial {
          entry {
            new Match {
              cases {
                new Case {
                  of = "hasPendingJoin"
                  yields {
                    new Match {
                      cases {
                        new Case {
                          of = "rightNeighbor == 'instantiated0' && pendingJoinId != id"
                          yields {
                            new Eval {
                              expression =
                                "rightNeighbor = pendingJoinId; hasRightFork = false; hasRightToken = true; rightForkDirty = true"
                            }
                          }
                        }
                        new Case {
                          of = "id == 'instantiated0' && pendingJoinId != id"
                          yields {
                            new Eval {
                              expression =
                                "leftNeighbor = pendingJoinId; hasLeftFork = false; hasLeftToken = true; leftForkDirty = true"
                            }
                          }
                        }
                      }
                    }
                    new Eval { expression = "hasPendingJoin = false" }
                  }
                }
              }
            }
            new Emit { event = new Internal { topic = "evaluateForks" } }
          }
          on {
            ["evaluateForks"] {
              yields {
                new Match {
                  cases {
                    new Case {
                      of = "!hasLeftFork && hasLeftToken"
                      yields {
                        new Eval { expression = "hasLeftToken = false" }
                        new Emit {
                          event { topic = "requestRightFork" }
                          target = "leftNeighbor.toString()"
                        }
                      }
                    }
                    new Case {
                      of = "!hasRightFork && hasRightToken"
                      yields {
                        new Eval { expression = "hasRightToken = false" }
                        new Emit {
                          event { topic = "requestLeftFork" }
                          target = "rightNeighbor.toString()"
                        }
                      }
                    }
                  }
                }
                new Emit { event = new Internal { topic = "tryEat" } }
              }
            }
            ["join"] {
              yields {
                new Match {
                  cases {
                    new Case {
                      of = "rightNeighbor == 'instantiated0' && $id != id"
                      yields {
                        new Eval {
                          expression =
                            "rightNeighbor = $id; hasRightFork = false; hasRightToken = true; rightForkDirty = true"
                        }
                        new Emit { event = new Internal { topic = "evaluateForks" } }
                      }
                    }
                    new Case {
                      of = "id == 'instantiated0' && $id != id"
                      yields {
                        new Eval {
                          expression =
                            "leftNeighbor = $id; hasLeftFork = false; hasLeftToken = true; leftForkDirty = true"
                        }
                        new Emit { event = new Internal { topic = "evaluateForks" } }
                      }
                    }
                  }
                }
              }
            }

            ["tryEat"] {
              to = "eating"
              provided = "hasLeftFork && hasRightFork"
            }
            ["giveLeftFork"] {
              yields {
                new Eval { expression = "hasLeftFork = true; leftForkDirty = false" }
                new Emit { event = new Internal { topic = "tryEat" } }
              }
            }
            ["giveRightFork"] {
              yields {
                new Eval { expression = "hasRightFork = true; rightForkDirty = false" }
                new Emit { event = new Internal { topic = "tryEat" } }
              }
            }
            ["requestLeftFork"] {
              yields {
                new Eval { expression = "hasLeftToken = true" }
                new Match {
                  cases {
                    new Case {
                      of = "hasLeftFork && leftForkDirty"
                      yields {
                        new Eval { expression = "hasLeftFork = false" }
                        new Emit {
                          event { topic = "giveRightFork" }
                          target = "leftNeighbor.toString()"
                        }
                        new Eval { expression = "hasLeftToken = false" }
                        new Emit {
                          event { topic = "requestRightFork" }
                          target = "leftNeighbor.toString()"
                        }
                      }
                    }
                  }
                }
              }
            }
            ["requestRightFork"] {
              yields {
                new Eval { expression = "hasRightToken = true" }
                new Match {
                  cases {
                    new Case {
                      of = "hasRightFork && rightForkDirty"
                      yields {
                        new Eval { expression = "hasRightFork = false" }
                        new Emit {
                          event { topic = "giveLeftFork" }
                          target = "rightNeighbor.toString()"
                        }
                        new Eval { expression = "hasRightToken = false" }
                        new Emit {
                          event { topic = "requestLeftFork" }
                          target = "rightNeighbor.toString()"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        ["eating"] {
          static { ["meals"] = "0" }
          after {
            ["eating"] = new Timeout {
              delay = "std:randomAround(10,2)"
              triggers = new Emit { event = new Internal { topic = "ate" } }
            }
          }
          on {
            ["ate"] {
              to = "thinking"
              yields {
                new Eval { expression = "++meals" }
                new Ctr { counter = "philosopher.meals"; tags { ["id"] = "id.toString()" } }
                new Eval { expression = "leftForkDirty = true; rightForkDirty = true" }
                new Match {
                  cases {
                    new Case {
                      of = "hasPendingJoin"
                      yields {
                        new Match {
                          cases {
                            new Case {
                              of = "rightNeighbor == 'instantiated0' && pendingJoinId != id"
                              yields {
                                new Eval {
                                  expression =
                                    "rightNeighbor = pendingJoinId; hasRightFork = false; hasRightToken = true; rightForkDirty = true"
                                }
                              }
                            }
                            new Case {
                              of = "id == 'instantiated0' && pendingJoinId != id"
                              yields {
                                new Eval {
                                  expression =
                                    "leftNeighbor = pendingJoinId; hasLeftFork = false; hasLeftToken = true; leftForkDirty = true"
                                }
                              }
                            }
                          }
                        }
                        new Eval { expression = "hasPendingJoin = false" }
                      }
                    }
                  }
                }
                new Match {
                  cases {
                    new Case {
                      of = "hasLeftToken && hasLeftFork"
                      yields {
                        new Eval { expression = "hasLeftFork = false" }
                        new Emit {
                          event { topic = "giveRightFork" }
                          target = "leftNeighbor.toString()"
                        }
                      }
                    }
                    new Case {
                      of = "hasRightToken && hasRightFork"
                      yields {
                        new Eval { expression = "hasRightFork = false" }
                        new Emit {
                          event { topic = "giveLeftFork" }
                          target = "rightNeighbor.toString()"
                        }
                      }
                    }
                  }
                }
              }
            }
            ["requestLeftFork"] {
              yields { new Eval { expression = "hasLeftToken = true" } }
            }
            ["requestRightFork"] {
              yields { new Eval { expression = "hasRightToken = true" } }
            }
            ["join"] {
              yields { new Eval { expression = "hasPendingJoin = true; pendingJoinId = $id" } }
            }
          }
        }
        ["thinking"] {
          after {
            ["thinking"] = new Timeout {
              delay = "std:randomAround(10,2)"
              triggers = new Emit { event = new Internal { topic = "thought" } }
            }
          }
          on {
            ["thought"] { to = "hungry" }
            ["requestLeftFork"] {
              yields {
                new Eval { expression = "hasLeftToken = true" }
                new Match {
                  cases {
                    new Case {
                      of = "hasLeftFork && leftForkDirty"
                      yields {
                        new Eval { expression = "hasLeftFork = false" }
                        new Emit {
                          event { topic = "giveRightFork" }
                          target = "leftNeighbor.toString()"
                        }
                      }
                    }
                  }
                }
              }
            }
            ["requestRightFork"] {
              yields {
                new Eval { expression = "hasRightToken = true" }
                new Match {
                  cases {
                    new Case {
                      of = "hasRightFork && rightForkDirty"
                      yields {
                        new Eval { expression = "hasRightFork = false" }
                        new Emit {
                          event { topic = "giveLeftFork" }
                          target = "rightNeighbor.toString()"
                        }
                      }
                    }
                  }
                }
              }
            }
            ["join"] {
              yields { new Eval { expression = "hasPendingJoin = true; pendingJoinId = $id" } }
            }
          }
        }
      }
    }
    ["instantiator"] {
      states {
        ["wait"] = new Initial {
          always {
            new Transition {
              to = "instantiate"
              provided = "count == 0"
              yields { new Eval { expression = "count = \(n)" } }
            }
          }
          on {
            ["join"] {
              to = "wait"
              yields { new Eval { expression = "--count" } }
            }
          }
        }
        ["instantiate"] = new State {
          after {
            ["instantiate"] = new Timeout {
              delay = "10000"
              triggers = new Emit { event = new Internal { topic = "instantiate" } }
            }
          }
          on {
            ["instantiate"] {
              to = "wait"
              yields {
                new Instantiate {
                  instances {
                    [Pair("instantiated", "lastInstantiated.toString()")] = new Instance {
                      stateMachineName = "philosopher"
                      data {
                        ["id"] = "'instantiated' + lastInstantiated.toString()"
                        ["hasLeftFork"] = "true"
                        ["hasRightFork"] = "true"
                        ["hasLeftToken"] = "false"
                        ["hasRightToken"] = "false"
                        ["leftForkDirty"] = "true"
                        ["rightForkDirty"] = "true"
                        ["leftNeighbor"] =
                          "if (lastInstantiated == 0) 'instantiated0' else 'instantiated' + (lastInstantiated - 1).toString()"
                        ["rightNeighbor"] = "'instantiated0'"
                        ["hasPendingJoin"] = "false"
                        ["pendingJoinId"] = "''"
                      }
                    }
                  }
                }
                new Emit {
                  event {
                    topic = "join"
                    data { ["id"] = "'instantiated' + lastInstantiated.toString()" }
                  }
                }
                new Eval { expression = "lastInstantiated += \(n)" }
              }
            }
          }
        }
      }
    }
  }
}

instances {
  for (i in IntSeq(0, n - 1)) {
    ["instantiator\(i)"] {
      stateMachineName = "instantiator"
      data {
        ["id"] = "\(i)"
        ["count"] = "\(i)"
        ["lastInstantiated"] = "\(i)"
      }
    }
  }
}
