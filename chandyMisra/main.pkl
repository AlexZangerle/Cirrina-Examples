amends
  "https://raw.githubusercontent.com/Frnd-me/Cirrina/refs/heads/develop/src/main/resources/pkl/csm/csml.pkl"

local n = 6

collaborativeStateMachine {
  stateMachines {
    ["philosopher"] {
      states {
        ["ready"] = new Initial {
          after {
            ["startup"] = new Timeout {
              delay = "2000"
              triggers = new Emit { event = new Internal { topic = "go" } }
            }
          }
          always {
            new Transition {
              to = "hungry"
              provided = "id >= 6"
            }
          }
          on {
            ["go"] { to = "hungry" }
          }
        }
        ["hungry"] = new State {
          entry {
            new Log { message = "id + ' is hungry'" }
            new Log { message = "id + ' Tokens: ' + hasLeftToken + ' ' + hasRightToken" }
            new Log { message = "id + ' Forks:  ' + hasLeftFork + ' ' + hasRightFork" }
            new Log { message = "id + ' Dirty:  ' + leftForkDirty + ' ' + rightForkDirty" }
            new Match {
              cases {
                new Case {
                  of = "hasPendingJoin"
                  yields {
                    new Log { message = "id + ' processing pending join for ' + pendingJoinId" }
                    new Match {
                      cases {
                        new Case {
                          of = "rightNeighbor == 0 && pendingJoinId != id"
                          yields {
                            new Log { message = "id + ' updating rightNeighbor to ' + pendingJoinId" }
                            new Eval { expression = "rightNeighbor = pendingJoinId; hasRightFork = false; hasRightToken = true; rightForkDirty = true" }
                          }
                        }
                        new Case {
                          of = "id == 0"
                          yields {
                            new Log { message = "id + ' updating leftNeighbor to ' + pendingJoinId" }
                            new Eval { expression = "leftNeighbor = pendingJoinId; hasLeftFork = false; hasLeftToken = true; leftForkDirty = true" }
                          }
                        }
                      }
                    }
                    new Eval { expression = "hasPendingJoin = false" }
                  }
                }
              }
            }
            new Emit { event = new Internal { topic = "evaluateForks" } }
          }
          on {
            ["evaluateForks"] {
              yields {
                new Match {
                  cases {
                    new Case {
                      of = "!hasLeftFork && hasLeftToken"
                      yields {
                        new Log { message = "id + ' requesting left fork from ' + leftNeighbor" }
                        new Eval { expression = "hasLeftToken = false" }
                        new Emit {
                          event { topic = "requestRightFork" }
                          target = "leftNeighbor.toString()"
                        }
                      }
                    }
                    new Case {
                      of = "!hasRightFork && hasRightToken"
                      yields {
                        new Log { message = "id + ' requesting right fork from ' + rightNeighbor" }
                        new Eval { expression = "hasRightToken = false" }
                        new Emit {
                          event { topic = "requestLeftFork" }
                          target = "rightNeighbor.toString()"
                        }
                      }
                    }
                  }
                }
                new Emit { event = new Internal { topic = "tryEat" } }
              }
            }

            ["join"] {
              yields {
                new Log { message = "id + ' received join for ' + $id + ' (in hungry)'" }
                new Match {
                  cases {
                    new Case {
                      of = "rightNeighbor == 0 && $id != id"
                      yields {
                        new Log { message = "id + ' instantly updating rightNeighbor to ' + $id" }
                        new Eval { expression = "rightNeighbor = $id; hasRightFork = false; hasRightToken = true; rightForkDirty = true" }
                        new Emit { event = new Internal { topic = "evaluateForks" } }
                      }
                    }
                    new Case {
                      of = "id == 0"
                      yields {
                        new Log { message = "id + ' instantly updating leftNeighbor to ' + $id" }
                        new Eval { expression = "leftNeighbor = $id; hasLeftFork = false; hasLeftToken = true; leftForkDirty = true" }
                        new Emit { event = new Internal { topic = "evaluateForks" } }
                      }
                    }
                  }
                }
              }
            }

            ["tryEat"] {
              to = "eating"
              provided = "hasLeftFork && hasRightFork"
            }
            ["giveLeftFork"] {
              yields {
                new Eval { expression = "hasLeftFork = true; leftForkDirty = false" }
                new Log { message = "id + ' received LEFT fork, forks: ' + hasLeftFork + ' ' + hasRightFork" }
                new Emit { event = new Internal { topic = "tryEat" } }
              }
            }
            ["giveRightFork"] {
              yields {
                new Eval { expression = "hasRightFork = true; rightForkDirty = false" }
                new Log { message = "id + ' received RIGHT fork, forks: ' + hasLeftFork + ' ' + hasRightFork" }
                new Emit { event = new Internal { topic = "tryEat" } }
              }
            }
            ["requestLeftFork"] {
              yields {
                new Log { message = "id + ' received Left request from ' + leftNeighbor + ' (in hungry)'" }
                new Eval { expression = "hasLeftToken = true" }
                new Match {
                  cases {
                    new Case {
                      of = "hasLeftFork && leftForkDirty"
                      yields {
                        new Log { message = "id + ' surrendering dirty LEFT fork to ' + leftNeighbor" }
                        new Eval { expression = "hasLeftFork = false" }
                        new Emit {
                          event { topic = "giveRightFork" }
                          target = "leftNeighbor.toString()"
                        }
                        new Eval { expression = "hasLeftToken = false" }
                        new Emit {
                          event { topic = "requestRightFork" }
                          target = "leftNeighbor.toString()"
                        }
                      }
                    }
                  }
                }
              }
            }
            ["requestRightFork"] {
              yields {
                new Log { message = "id + ' received RIGHT request from ' + rightNeighbor + ' (in hungry)'" }
                new Eval { expression = "hasRightToken = true" }
                new Match {
                  cases {
                    new Case {
                      of = "hasRightFork && rightForkDirty"
                      yields {
                        new Log { message = "id + ' surrendering dirty RIGHT fork to ' + rightNeighbor" }
                        new Eval { expression = "hasRightFork = false" }
                        new Emit {
                          event { topic = "giveLeftFork" }
                          target = "rightNeighbor.toString()"
                        }
                        new Eval { expression = "hasRightToken = false" }
                        new Emit {
                          event { topic = "requestLeftFork" }
                          target = "rightNeighbor.toString()"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        ["eating"] {
          static { ["meals"] = "0" }
          entry {
            new Log { message = "id + ' EATING (meals so far: ' + meals + ')'" }
          }
          after {
            ["eating"] = new Timeout {
              delay = "std:randomAround(10,2)"
              triggers = new Emit { event = new Internal { topic = "ate" } }
            }
          }
          on {
            ["ate"] {
              to = "thinking"
              yields {
                new Eval { expression = "++meals" }
                new Ctr { counter = "philosopher.meals"; tags { ["id"] = "id.toString()" } }
                new Eval { expression = "leftForkDirty = true; rightForkDirty = true" }
                new Log {
                  message =
                    "id + ' done eating, deferred: L=' + hasLeftToken + ' R=' + hasRightToken"
                }
                new Match {
                  cases {
                    new Case {
                      of = "hasLeftToken && hasLeftFork"
                      yields {
                        new Log { message = "id + ' fulfilling deferred LEFT to ' + leftNeighbor" }
                        new Eval { expression = "hasLeftFork = false" }
                        new Emit {
                          event { topic = "giveRightFork" }
                          target = "leftNeighbor.toString()"
                        }
                      }
                    }
                    new Case {
                      of = "hasRightToken && hasRightFork"
                      yields {
                        new Log {
                          message = "id + ' fulfilling deferred RIGHT to ' + rightNeighbor"
                        }
                        new Eval { expression = "hasRightFork = false" }
                        new Emit {
                          event { topic = "giveLeftFork" }
                          target = "rightNeighbor.toString()"
                        }
                      }
                    }
                  }
                }
              }
            }
            ["requestLeftFork"] {
              yields {
                new Log { message = "id + ' deferring LEFT fork request (eating)'" }
                new Eval { expression = "hasLeftToken = true" }
              }
            }
            ["requestRightFork"] {
              yields {
                new Log { message = "id + ' deferring RIGHT fork request (eating)'" }
                new Eval { expression = "hasRightToken = true" }
              }
            }
            ["join"] {
              yields {
                new Log { message = "id + ' received join for ' + $id + ' (in eating)'" }
                new Eval { expression = "hasPendingJoin = true; pendingJoinId = $id" }
              }
            }
          }
        }
        ["thinking"] {
          entry {
            new Log { message = "id + ' thinking'" }
          }
          after {
            ["thinking"] = new Timeout {
              delay = "std:randomAround(10,2)"
              triggers = new Emit { event = new Internal { topic = "thought" } }
            }
          }
          on {
            ["thought"] {
              to = "hungry"
            }
            ["requestLeftFork"] {
              yields {
                new Eval { expression = "hasLeftToken = true" }
                new Match {
                  cases {
                    new Case {
                      of = "hasLeftFork && leftForkDirty"
                      yields {
                        new Log {
                          message = "id + ' surrendering LEFT fork (thinking) to ' + leftNeighbor"
                        }
                        new Eval { expression = "hasLeftFork = false" }
                        new Emit {
                          event { topic = "giveRightFork" }
                          target = "leftNeighbor.toString()"
                        }
                      }
                    }
                  }
                }
              }
            }
            ["requestRightFork"] {
              yields {
                new Eval { expression = "hasRightToken = true" }
                new Match {
                  cases {
                    new Case {
                      of = "hasRightFork && rightForkDirty"
                      yields {
                        new Log {
                          message = "id + ' surrendering RIGHT fork (thinking) to ' + rightNeighbor"
                        }
                        new Eval { expression = "hasRightFork = false" }
                        new Emit {
                          event { topic = "giveLeftFork" }
                          target = "rightNeighbor.toString()"
                        }
                      }
                    }
                  }
                }
              }
            }
            ["join"] {
              yields {
                new Log { message = "id + ' received join for ' + $id + ' (in thinking)'" }
                new Eval { expression = "hasPendingJoin = true; pendingJoinId = $id" }
              }
            }
          }
        }
      }
    }
    ["instantiator"] {
      states {
        ["wait"] = new Initial {
          always {
            new Transition {
              to = "instantiate"
              provided = "count == 0"
              yields {
                new Eval { expression = "count = \(n)"}
              }
            }
          }
          on {
            ["join"] {
              to = "wait"
              yields {
                new Eval { expression = "count = \(n)"}
              }
            }
          }
        }
        ["instantiate"] {
          after {
            ["instantiate"] = new Timeout {
              delay = "5000"
              triggers = new Emit { event = new Internal { topic = "instantiate" } }
            }
          }
          on {
            ["instantiate"] {
              yields {
                new Eval { expression = "lastInstantiated += \(n)" }
                new Log {
                  message = "'instantiator ' + id + ' spawning sm philosopher' + lastInstantiated "
                }
                new Instantiate {
                  instances {
                    ["lastInstantiated.toString()"] = new Instance {
                      stateMachineName = "philosopher"
                      data {
                        ["id"] = "lastInstantiated"
                        ["hasLeftFork"] = "true"
                        ["hasRightFork"] = "true"
                        ["hasLeftToken"] = "false"
                        ["hasRightToken"] = "false"
                        ["leftForkDirty"] = "true"
                        ["rightForkDirty"] = "true"
                        ["leftNeighbor"] = "lastInstantiated - 1"
                        ["rightNeighbor"] = "0"
                        ["hasPendingJoin"] = "false"
                        ["pendingJoinId"] = "0"
                      }
                    }
                  }
                }
                new Emit { event { topic = "join"; data { ["id"] = "lastInstantiated" } } }
              }
            }
          }
        }
      }
    }
  }
}

instances {
  for (i in IntSeq(0, n - 1)) {
    ["instantiator\(i)"] {
      stateMachineName = "instantiator"
      data {
        ["id"] = "\(i)"
        ["count"] = "\(i)"
        ["lastInstantiated"] = "\(i)"
      }
    }
    ["\(i)"] {
      stateMachineName = "philosopher"
      data {
        ["id"] = "\(i)"
        ["hasLeftFork"] = "\(i) > (\(i) - 1 + \(n)) % \(n)"
        ["hasRightFork"] = "\(i) > (\(i) + 1) % \(n)"
        ["hasLeftToken"] = "\(i) < (\(i) - 1 + \(n)) % \(n)"
        ["hasRightToken"] = "\(i) < (\(i) + 1) % \(n)"
        ["leftForkDirty"] = "\(i) > (\(i) - 1 + \(n)) % \(n)"
        ["rightForkDirty"] = "\(i) > (\(i) + 1) % \(n)"
        ["leftNeighbor"] = "(\(i) - 1 + \(n)) % \(n)"
        ["rightNeighbor"] = "(\(i) + 1) % \(n)"
        ["hasPendingJoin"] = "false"
        ["pendingJoinId"] = "0"
      }
    }
  }
}
